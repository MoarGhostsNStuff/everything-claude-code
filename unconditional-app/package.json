{
  "name": "unconditional",
  "version": "1.0.0",
  "description": "Love, Wellness & Mental Health Companion - PWA & Native App",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -p 3456",
    "icons": "node generate-icons.js",
    "cap:init": "npx cap init Unconditional com.unconditional.app --web-dir .",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "build:native": "node build-native.js",
    "build:ios": "npm run cap:sync && npx cap open ios",
    "build:mac": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/motion": "^6.0.2",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "serve": "^14.0.0",
    "sharp": "^0.35.4"
  }
}
